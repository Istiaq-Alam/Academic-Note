% Report parameters
\def\reporttitle{\input{Parameters/ReportTitle.txt}\unskip}
\def\reportdate{\input{Parameters/ReportDate.txt}\unskip}
\def\companyname{\input{Parameters/CompanyName.txt}\unskip}
\def\duration{\input{Parameters/InternshipDuration.txt}\unskip}

% Report title page 
\pagenumbering{Alpha}
\renewcommand{\maketitle}{
  \thispagestyle{empty}
  \begin{center}
   \Large{ B.Sc.\ in Computer Science and Engineering}\\
    \vspace*{\stretch{2}}
    \textbf{{\Large\reporttitle}}

    \vspace*{\stretch{5}}
    {\Large Submitted by}\\
    \DTLforeach{Students}{\StudentName=Column1,\StudentID=Column2}{\vspace*{\stretch{1}}\StudentName\\\StudentID\\}
    \vspace*{\stretch{3}}
    {\Large Supervised by}\\
    \vspace*{\stretch{1}}
    \DTLforeach{Supervisor}{\SupervisorName=Column1,\SupervisorDesignation=Column2}{\SupervisorName}\\
    \vspace*{\stretch{4}}{\tiny.}\vspace*{\stretch{2}}
    \includegraphics[width=30mm]{Images/ndublogo}\\
    \textbf{\cse}\\
    \textbf{\Large\ndub}\\
    \medskip
    Dhaka, Bangladesh\\
    \bigskip
    \vspace*{\stretch{1}}
    \reportdate
  \end{center}}

%end of my title

